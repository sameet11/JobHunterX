# Gemini API — get a key at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash   # or gemini-2.0-pro for higher accuracy


# ── Job scraping (optional — only needed if you enable these scrapers) ──

# Adzuna India Jobs API (free at developer.adzuna.com — 250 req/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Apify (LinkedIn + Indeed scrapers — apify.com, free tier ~$5 credit)
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR=curious_coder~linkedin-jobs-scraper
APIFY_PER_SOURCE_LIMIT=100   # Max jobs to fetch per source per pipeline run


# ── Google Sheets (OAuth 2.0 — no service account needed) ──
# Get GOOGLE_SHEET_ID from your sheet URL: docs.google.com/spreadsheets/d/{ID}/edit
# On first run you'll be prompted to authorize via browser
GOOGLE_SHEET_ID=


# ── Settings ──
MIN_MATCH_SCORE=40      # Pre-filter threshold 0–100
LOG_LEVEL=INFO
