# Vertex AI (Gemini) — Uses ADC (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-2.0-flash-001   # or gemini-2.0-pro-001 for higher accuracy
# No service account file needed — uses local ADC credentials from ~/.config/gcloud


# Job search

# Adzuna India Jobs API (free at developer.adzuna.com — 250 req/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Apify (LinkedIn + Indeed scrapers — apify.com, free tier ~$5 credit)
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR=curious_coder~linkedin-jobs-scraper
APIFY_INDEED_ACTOR=misceres~indeed-scraper
APIFY_PER_SOURCE_LIMIT=100   # Max jobs to fetch per source per pipeline run

# Email/Outreach (Phase 3)
HUNTER_API_KEY=           # Optional: for recruiter finding (Hunter.io API key)
GMAIL_SENDER_EMAIL=       # Required for Phase 3 email: your Gmail address (from/reply-to)
GMAIL_APP_PASSWORD=       # Required for Phase 3 email: 16-char app password from myaccount.google.com/apppasswords

# Platform credentials (Phase 2 apply + Phase 3 outreach)
# LinkedIn outreach now auto-reads session cookies from your logged-in browser
# (Chrome → Edge → Firefox). Just stay logged into linkedin.com — no config needed.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# Google Sheets (OAuth 2.0 — no service account needed)
# GOOGLE_SHEET_ID — get from your sheet URL
# On first run, you'll be prompted to authorize via browser
GOOGLE_SHEET_ID=

# Database (optional PostgreSQL via Docker — default is SQLite)
# Leave empty to use SQLite (data/applied.sqlite)
# Set to use PostgreSQL: postgresql://jobhunter:jobhunter_dev_password@localhost:5432/jobhunterx
DATABASE_URL=

# Settings
DAILY_LIMIT=15          # Max applications per day (Phase 2)
MIN_MATCH_SCORE=40      # Pre-filter threshold 0-100 (Claude re-scores precisely after)
LOG_LEVEL=INFO

